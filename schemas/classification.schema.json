{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classification.schema.json",
  "title": "Classification",
  "description": "SDD-R002 Engineering Classification Model, with Tags/Keywords/Aliases folded in from SDD-R001 §7. Every classification dimension is independent -- none implies another (SDD-R002 §17).",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "category"],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1,
      "description": "SDD-R002 §4 -- the highest engineering discipline (e.g. Electrical)."
    },
    "discipline": {
      "type": "string",
      "description": "SDD-R002 §5 -- specializes Domain (e.g. Electronics)."
    },
    "family": {
      "type": "string",
      "description": "SDD-R002 §6 -- broad grouping (e.g. Passive Components)."
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "SDD-R002 §7 -- refines Family (e.g. Resistors)."
    },
    "subcategory": {
      "type": "string",
      "description": "SDD-R002 §7 -- further refines Category (e.g. Fixed Resistor)."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "roles": {
      "type": "array",
      "description": "SDD-R002 §8 -- how the object participates in OEP workflows.",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "capabilities": {
      "type": "array",
      "description": "SDD-R002 §9 -- what platform services may consume the object.",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "authority": {
      "type": "string",
      "description": "SDD-R002 §11.",
      "default": "Core OEP"
    },
    "visibility": {
      "type": "string",
      "description": "SDD-R002 §12.",
      "default": "Public"
    },
    "ownership": {
      "type": "string",
      "description": "SDD-R002 §13 -- the maintaining organization."
    },
    "standards": {
      "type": "array",
      "description": "SDD-R002 §14.",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "industries": {
      "type": "array",
      "description": "SDD-R002 §15.",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "technologies": {
      "type": "array",
      "description": "SDD-R002 §16.",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    }
  }
}
