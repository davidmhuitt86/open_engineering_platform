# Build artifacts. Per SDD-R010 §16, "Compiler output shall never be
# submitted" -- compiled .oerp packages and intermediate build state
# are generated by the Reference Compiler, never committed as source.
/dist/
*.oerp

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
build/
