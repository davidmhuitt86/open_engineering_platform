{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "history.schema.json",
  "title": "History Facet",
  "description": "SDD-R011 §18. Records object evolution. Never destroyed -- entries are only ever appended.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lifecycle_events"],
  "properties": {
    "previous_versions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
      "default": []
    },
    "superseded_by": {
      "type": ["string", "null"],
      "default": null,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "migration_notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "deprecation_history": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "lifecycle_events": {
      "type": "array",
      "minItems": 1,
      "description": "At least the object's initial creation/publication event.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "date"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["Draft", "Under Review", "Technically Verified", "Approved", "Published", "Deprecated", "Superseded", "Archived"]
          },
          "date": { "type": "string", "format": "date" },
          "notes": { "type": "string", "default": "" }
        }
      }
    }
  }
}
