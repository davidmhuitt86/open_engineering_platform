{
  "name": "@oep-exchange/installer",
  "version": "0.1.0",
  "private": true,
  "description": "Invokes the Package Transaction Engine and Repository Merge Engine, through public Repository interfaces only, to install a downloaded package into an OEP Repository.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@oep-exchange/core": "0.1.0",
    "@oep-exchange/exchange-client": "0.1.0",
    "@oep-exchange/interfaces": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  }
}
